{
  "name": "ryanpotter/silverstripe-color-field",
  "description": "Silverstripe Color Field",
  "type": "silverstripe-vendormodule",
  "keywords": [
    "silverstripe"
  ],
  "license": "BSD-3-Clause",
  "authors": [
    {
      "name": "Ryan Potter",
      "homepage": "http://ryanpotter.co.nz/",
      "role": "Developer"
    }
  ],
  "require": {
    "silverstripe/framework": "^6.0"
  },
  "require-dev": {
    "cambis/silverstan": "^2.1",
    "cambis/silverstripe-rector": "^2.1",
    "phpstan/extension-installer": "^1.4",
    "phpstan/phpstan": "^2.1",
    "phpstan/phpstan-deprecation-rules": "^2.0",
    "rector/rector": "^2.2",
    "rector/type-perfect": "^2.1"
  },
  "support": {
    "issues": "https://github.com/Rhym/silverstripe-color-field/issues"
  },
  "extra": {
    "installer-name": "silverstripe-color-field",
    "expose": [
      "client"
    ]
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "composer/installers": true,
      "phpstan/extension-installer": true,
      "silverstripe/vendor-plugin": true
    }
  }
}
